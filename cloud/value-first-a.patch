+++ b/src/economy/value-guard.ts
@@ -0,0 +1,97 @@
+import type { AgentTurn } from "../types.js";
+
+const HARD_VALUE_TOOLS = new Set([
+  "complete_goal",
+  "x402_fetch",
+  "register_domain",
+  "expose_port",
+  "create_sandbox",
+  "git_commit",
+  "git_push",
+  "send_message",
+  "register_erc8004",
+  "fund_child",
+  "transfer_credits",
+]);
+
+const LOW_VALUE_TOOLS = new Set([
+  "get_plan",
+  "orchestrator_status",
+  "list_goals",
+  "check_credits",
+  "check_usdc_balance",
+  "check_inference_spending",
+  "review_upstream_changes",
+  "sleep",
+]);
+
+function cleanResult(turnResult: string | undefined): string {
+  return String(turnResult || "").toLowerCase();
+}
+
+export function turnCreatedValue(
+  turn: AgentTurn,
+  seenArtifacts: Set<string>,
+  economicValueBeforeCents?: bigint,
+  economicValueAfterCents?: bigint,
+): { createdValue: boolean; reason: string } {
+  if (
+    typeof economicValueBeforeCents === "bigint" &&
+    typeof economicValueAfterCents === "bigint" &&
+    economicValueAfterCents > economicValueBeforeCents
+  ) {
+    return { createdValue: true, reason: "economic_value_increased" };
+  }
+
+  for (const tc of turn.toolCalls) {
+    if (tc.error) continue;
+
+    if (HARD_VALUE_TOOLS.has(tc.name)) {
+      return { createdValue: true, reason: `tool:${tc.name}` };
+    }
+
+    if (tc.name === "write_file" || tc.name === "edit_own_file") {
+      const artifactPath = String(
+        (tc.arguments as Record<string, unknown>)?.path ??
+        (tc.arguments as Record<string, unknown>)?.file_path ??
+        "",
+      ).trim();
+      const lowerPath = artifactPath.toLowerCase();
+      const lowValueDocument =
+        /(^|\/)(readme|worklog|todo|plan|idea|proposal|notes?|status|soul)([._/-]|$)/i.test(lowerPath) ||
+        lowerPath.endsWith(".md") ||
+        lowerPath.endsWith(".txt");
+      if (artifactPath && !lowValueDocument && !seenArtifacts.has(artifactPath)) {
+        seenArtifacts.add(artifactPath);
+        return { createdValue: true, reason: `new_product_artifact:${artifactPath}` };
+      }
+      continue;
+    }
+
+    if (tc.name === "exec") {
+      const result = cleanResult(tc.result);
+      const command = String((tc.arguments as Record<string, unknown>)?.command || "").trim();
+      const blocked = /disabled|blocked|not allowed|intentionally disabled|error:/.test(result);
+      const readOnly = /^(ls|pwd|cat|head|tail|grep|find|git status|git log)(\s|$)/i.test(command);
+      if (!blocked && command && !readOnly) {
+        return { createdValue: true, reason: "productive_exec" };
+      }
+      continue;
+    }
+
+    if (!LOW_VALUE_TOOLS.has(tc.name)) {
+      const result = cleanResult(tc.result);
+      if (result && !/blocked|error|failed|not found/.test(result)) {
+        return { createdValue: true, reason: `successful_tool:${tc.name}` };
+      }
+    }
+  }
+
+  return { createdValue: false, reason: "no_verified_progress" };
+}
+
+export function nextValueHoldMs(previousHoldCount: number): number {
+  const base = 5 * 60_000;
+  const exponent = Math.min(Math.max(previousHoldCount, 0), 4);
+  return Math.min(base * 2 ** exponent, 60 * 60_000);
+}