@@ -0,0 +1,53 @@
+import type { AutomatonDatabase } from "../types.js";
+import { ECONOMY } from "./types.js";
+import { getCreationDebtSummary } from "./obligations.js";
+
+export interface InferenceFundingCapacity {
+  economicValueCents: number;
+  protectedReserveCents: number;
+  creationDebtCents: number;
+  freeSpendableCents: number;
+}
+
+export function getInferenceFundingCapacity(
+  db: AutomatonDatabase,
+  agentId: string,
+): InferenceFundingCapacity {
+  const state = db.getEconomyState(agentId);
+  const debt = getCreationDebtSummary(db, agentId);
+  const economicValueCents = Number(state?.economicValueCents ?? 0n);
+  const protectedReserveCents = Number(ECONOMY.STARTING_CAPITAL_CENTS);
+  const creationDebtCents = debt.totalCents;
+  const freeSpendableCents = Math.max(
+    0,
+    economicValueCents - protectedReserveCents - creationDebtCents,
+  );
+
+  return {
+    economicValueCents,
+    protectedReserveCents,
+    creationDebtCents,
+    freeSpendableCents,
+  };
+}
+
+export function canSelfFundInference(
+  db: AutomatonDatabase,
+  agentId: string,
+  requestedCents: number,
+): { allowed: boolean; reason: string; capacity: InferenceFundingCapacity } {
+  const capacity = getInferenceFundingCapacity(db, agentId);
+  if (!Number.isSafeInteger(requestedCents) || requestedCents <= 0) {
+    return { allowed: false, reason: "invalid inference funding amount", capacity };
+  }
+  if (capacity.freeSpendableCents < requestedCents) {
+    return {
+      allowed: false,
+      reason:
+        `free spendable capital ${capacity.freeSpendableCents}c is below requested ${requestedCents}c ` +
+        `after protected reserve ${capacity.protectedReserveCents}c and creation debt ${capacity.creationDebtCents}c`,
+      capacity,
+    };
+  }
+  return { allowed: true, reason: "ok", capacity };
+}
