+import { afterEach, describe, expect, it } from "vitest";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createDatabase } from "../state/database.js";
+import { createEconomyState } from "../economy/engine.js";
+import {
+  canCreateChildEconomically,
+  reconcileHistoricalChildCreationEconomics,
+  registerNewChildCreationEconomics,
+} from "../economy/obligations.js";
+
+const dirs: string[] = [];
+function makeDb() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "novens-economy-"));
+  dirs.push(dir);
+  return createDatabase(path.join(dir, "state.db"));
+}
+
+afterEach(() => {
+  for (const dir of dirs.splice(0)) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+describe("inherited child economics", () => {
+  it("records the three historical children as EUR150 owner debt plus EUR50 per child", () => {
+    const db = makeDb();
+    db.setIdentity("automatonId", "parent");
+    const state = createEconomyState("parent", "0x1111111111111111111111111111111111111111", "0x9999999999999999999999999999999999999999");
+    db.saveEconomyState(state);
+
+    for (let i = 0; i < 3; i++) {
+      db.insertChild({
+        id: "child-" + i,
+        name: "child-" + i,
+        address: ("0x" + String(i + 2).repeat(40)) as `0x${string}`,
+        sandboxId: "sandbox-" + i,
+        genesisPrompt: "test",
+        fundedAmountCents: 0,
+        status: "failed",
+        createdAt: new Date().toISOString(),
+      });
+    }
+
+    const debt = reconcileHistoricalChildCreationEconomics(db, "parent", "0x9999999999999999999999999999999999999999");
+    expect(debt.ownerCents).toBe(15_000);
+    expect(debt.childCents).toBe(15_000);
+    expect(debt.totalCents).toBe(30_000);
+    expect(db.getEconomyState("parent")?.childrenCreated).toBe(3);
+    expect(canCreateChildEconomically(db, "parent").allowed).toBe(false);
+    db.close();
+  });
+
+  it("at EUR150, one creation leaves EUR50 and creates EUR50 owner + EUR50 child obligations", () => {
+    const db = makeDb();
+    db.setIdentity("automatonId", "parent");
+    const state = createEconomyState("parent", "0x1111111111111111111111111111111111111111", "0x9999999999999999999999999999999999999999");
+    state.capitalCents = 15_000n;
+    state.economicValueCents = 15_000n;
+    db.saveEconomyState(state);
+
+    expect(canCreateChildEconomically(db, "parent").allowed).toBe(true);
+    registerNewChildCreationEconomics(
+      db,
+      "parent",
+      "0x9999999999999999999999999999999999999999",
+      "child-new",
+      "0x2222222222222222222222222222222222222222",
+    );
+
+    const next = db.getEconomyState("parent");
+    expect(next?.economicValueCents).toBe(5_000n);
+    expect(next?.childrenCreated).toBe(1);
+    const debt = canCreateChildEconomically(db, "parent").debt;
+    expect(debt.ownerCents).toBe(5_000);
+    expect(debt.childCents).toBe(5_000);
+    expect(canCreateChildEconomically(db, "parent").allowed).toBe(false);
+    db.close();
+  });
+});
