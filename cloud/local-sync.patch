diff --git a/src/economy/obligations.ts b/src/economy/obligations.ts
new file mode 100644
index 0000000..9b353cc
--- /dev/null
+++ b/src/economy/obligations.ts
@@ -0,0 +1,184 @@
+import type { AutomatonDatabase } from "../types.js";
+import { canDeploy, registerDeployment } from "./engine.js";
+import { ECONOMY } from "./types.js";
+
+export interface CreationDebtSummary {
+  ownerCents: number;
+  childCents: number;
+  totalCents: number;
+  owedCount: number;
+}
+
+function obligationId(childId: string, beneficiary: "owner" | "child"): string {
+  return `child-creation:${childId}:${beneficiary}`;
+}
+
+function insertObligation(
+  db: AutomatonDatabase,
+  agentId: string,
+  childId: string,
+  beneficiaryType: "owner" | "child",
+  beneficiaryRef: string,
+  amountCents: number,
+): void {
+  db.raw.prepare(
+    `INSERT OR IGNORE INTO economic_obligations
+      (id, agent_id, child_id, beneficiary_type, beneficiary_ref, amount_cents, status, reason)
+     VALUES (?, ?, ?, ?, ?, ?, 'owed', 'child_creation')`,
+  ).run(
+    obligationId(childId, beneficiaryType),
+    agentId,
+    childId,
+    beneficiaryType,
+    beneficiaryRef,
+    amountCents,
+  );
+}
+
+export function getCreationDebtSummary(
+  db: AutomatonDatabase,
+  agentId: string,
+): CreationDebtSummary {
+  const rows = db.raw.prepare(
+    `SELECT beneficiary_type, COALESCE(SUM(amount_cents), 0) AS total, COUNT(*) AS count
+     FROM economic_obligations
+     WHERE agent_id = ? AND status = 'owed' AND reason = 'child_creation'
+     GROUP BY beneficiary_type`,
+  ).all(agentId) as Array<{ beneficiary_type: string; total: number; count: number }>;
+
+  let ownerCents = 0;
+  let childCents = 0;
+  let owedCount = 0;
+  for (const row of rows) {
+    if (row.beneficiary_type === "owner") ownerCents = Number(row.total) || 0;
+    if (row.beneficiary_type === "child") childCents = Number(row.total) || 0;
+    owedCount += Number(row.count) || 0;
+  }
+  return {
+    ownerCents,
+    childCents,
+    totalCents: ownerCents + childCents,
+    owedCount,
+  };
+}
+
+export function reconcileHistoricalChildCreationEconomics(
+  db: AutomatonDatabase,
+  agentId: string,
+  ownerAddress: string,
+): CreationDebtSummary {
+  db.runTransaction(() => {
+    const children = db.getChildren().filter(
+      (child) => typeof child.address === "string" && child.address.length > 0,
+    );
+
+    for (const child of children) {
+      insertObligation(
+        db,
+        agentId,
+        child.id,
+        "owner",
+        ownerAddress,
+        Number(ECONOMY.OWNER_DEPLOYMENT_PAYOUT_CENTS),
+      );
+      insertObligation(
+        db,
+        agentId,
+        child.id,
+        "child",
+        child.address || child.id,
+        Number(ECONOMY.CHILD_STARTING_CAPITAL_CENTS),
+      );
+    }
+
+    const state = db.getEconomyState(agentId);
+    if (state && state.childrenCreated < children.length) {
+      state.childrenCreated = children.length;
+      if (state.childrenCreated >= ECONOMY.MAX_CHILDREN) state.mature = true;
+      db.saveEconomyState(state);
+    }
+  });
+
+  return getCreationDebtSummary(db, agentId);
+}
+
+export function canCreateChildEconomically(
+  db: AutomatonDatabase,
+  agentId: string,
