+/**
+ * Automaton exposes a legacy /root virtual workspace. Convert it into the
+ * Daytona sandbox's actual work directory without allowing path traversal.
+ */
+export function daytonaWorkspacePath(filePath: string, workDir: string): string {
+  const root = path.posix.normalize(workDir);
+  if (!root.startsWith("/") || root === "/") throw new Error("Invalid Daytona work directory");
+  const input = String(filePath || "").trim();
+  if (!input || input.includes("\\") || input.includes("\0")) {
+    throw new Error("Invalid sandbox file path");
+  }
+  const relative = input.startsWith("/root/") ? input.slice(6) :
+    input === "/root" ? "." : input.startsWith("~/") ? input.slice(2) :
+    input === "~" ? "." : input;
+  if (path.posix.isAbsolute(relative)) throw new Error("File outside sandbox workspace");
+  const resolved = path.posix.resolve(root, relative);
+  if (resolved !== root && !resolved.startsWith(root + "/")) {
+    throw new Error("File outside sandbox workspace");
+  }
+  return resolved;
+}
